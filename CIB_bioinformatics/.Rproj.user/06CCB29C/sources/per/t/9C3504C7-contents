```{r}
qPCR_AK_data$Quantity <- as.numeric(qPCR_AK_data$Quantity)
qPCR_AK_data %>% 
  filter(., `Sample Name`!="" & Sample.Name !="") %>% 
  dplyr::filter(Marker =="Beluga") %>% 
  filter(., `Target Name` =="cetacea") %>% 
  filter(., Task =="UNKNOWN") %>% 
  mutate(Quantity = ifelse(is.na(Quantity), 0, Quantity)) %>% 
  filter(., !is.na(LabID)) %>% 
  filter(., Quantity > 0) %>% 
  mutate( Site = case_when(Project =="Beluga_Diet"~"Beluga_Diet",
                                Control_Type=="Neg"~"Neg",
                                 Control_Type=="Pos"~"Pos")) %>% 
  filter(., !is.na(River)) %>% 
  mutate(., Sample_date=as.Date(Sample_date,"%m/%d/%y")) %>% 
 ggplot(aes(x=Sample_date, y=Quantity)) + geom_point()+ facet_wrap(River ~ .)+ theme_bw() +theme(axis.text.x = element_text(angle=30, hjust = 1), panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
panel.background = element_blank(), axis.text = element_text(size=14), axis.title = element_text(size=18), strip.text = element_text(size=16)) + scale_y_sqrt(breaks=c(0,10,50,100,200,400))
