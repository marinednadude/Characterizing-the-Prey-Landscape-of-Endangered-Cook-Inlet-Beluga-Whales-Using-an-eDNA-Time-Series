```{r}


fully_combo %>% 
      unite("sample", c("community", "tech_rep","Cycles"),sep=":", remove = F) %>%
  filter(., str_detect(community, "North_")& Cycles == 39) %>% 
    mutate(., Type="Metabarcoding",
           Community = case_when(str_detect(community, "Even")~"Even",
                                 str_detect(community, "1")~"Skew 1",
                                 str_detect(community, "2")~"Skew",
                                 TRUE ~"WRONG")) %>% 
    filter(., Community!="Skew 1") %>% 
  left_join(tot_reads) %>% 
  mutate(., prop=nReads/tot_reads) %>% 
  filter(., nReads > 0) -> northern_even_df_for_plotting


fully_combo %>% 
      unite("sample", c("community", "tech_rep","Cycles"),sep=":", remove = F) %>%
  filter(., str_detect(community,"North_") & Cycles == 30 & tech_rep==1) %>% 
  mutate(., Type="Mock",
           Community = case_when(str_detect(community, "Even")~"Even",
                                 str_detect(community, "1")~"Skew 1",
                                 str_detect(community, "2")~"Skew",
                                 TRUE ~"WRONG")) %>% 
  filter(., Community!="Skew 1") %>% 
  left_join(tot_reads) %>% 
  mutate(., prop=start_conc_ng/tot_ng) %>% 
  filter(., start_conc_ng > 0) ->northern_even_mock_for_plotting
  
# 1. Create a single vector of all unique species across both dataframes
species_northern_even <- unique(c(northern_even_df_for_plotting$ID_mifish, 
                                  northern_even_mock_for_plotting$ID_mifish))

# 2. Create a NAMED vector of colors (Name = Species, Value = Color)
species_colors <- col_vector[1:length(species_northern_even)]
species_colors[7] <- "black"
species_colors[10] <- "#efb28c"
species_colors[11] <- "#fa8775"
species_colors[12] <- "grey50"
species_colors[14] <- "#5f865f"
species_colors[16] <- "#a2d2df"
names(species_colors) <- species_northern_even

# 3. Plot the Metabarcoding data (Map fill directly to ID_mifish)
northern_even_df_for_plotting %>% 
  ggplot(aes(x=tech_rep, y=prop, fill=ID_mifish)) +
  geom_bar(position="stack", stat="identity") +
  facet_wrap(.~Community) +
  scale_fill_manual(values = species_colors, name = "Species") + 
  ylab("% Reads") + 
  xlab("Technical Replicate") +
    labs(title = "Metabarcoding") +
  theme_bw(base_size = 32) +
  theme(plot.title = element_text(hjust = 0.5),strip.text = element_text(face = "bold"), strip.background = element_rect(fill = "white", color = "black")) +
  scale_y_continuous(labels = scales::percent) -> north_stacked_bar_plot

# 4. Plot the Mock data (Map fill directly to ID_mifish)
northern_even_mock_for_plotting %>% 
  ggplot(aes(x=Community, y=prop, fill=ID_mifish)) +
  geom_bar(position="stack", stat="identity") +
  facet_wrap(.~Community, scales="free_x") +
  scale_fill_manual(values = species_colors, name = "Species") + 
  ylab("% Input DNA Copies") + 
  xlab("") +
  labs(title = "Mock") +
  theme_bw(base_size = 32) +
  theme(legend.position="none", plot.title = element_text(hjust = 0.5), strip.text = element_text(face = "bold"), strip.background = element_rect(fill = "white", color = "black") ) +
  scale_y_continuous(labels = scales::percent) -> north_stacked_bar_plot_mock

# 5. Combine plots
# 1. Completely remove the legend from the first plot
p1 <- north_stacked_bar_plot_mock + 
  guides(fill = "none")

# 2. Apply the row/column formatting strictly to the second plot's legend
p2 <- north_stacked_bar_plot + 
  guides(fill = guide_legend(nrow = 8, byrow = TRUE, title.position = "top", title.hjust = 0.5))

# 3. Combine the plots and position the single collected legend at the bottom
p1 + p2 + 
  plot_layout(guides = "collect") & 
  theme(
    legend.position = "bottom",
    legend.direction = "horizontal",
    legend.justification = "center",
    legend.box = "horizontal",
    legend.margin = margin(t = 0, r = 20, b = 0, l = 0) 
  )

ggsave(file=here("data","Mock_community_data","data","Figure_S4.1_Stacked_bar_plot_all.png"),
  width = 22,
  height = 14)


