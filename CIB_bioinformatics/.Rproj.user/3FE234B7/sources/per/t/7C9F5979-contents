  dplyr::summarise(mean_Quantity=mean(Quantity), mean_mean_dnacopy_L =mean(mean_dnacopy_L, na.rm = TRUE)) -> qpcr_detection_New_name_no_tech

# Calculate totals and detection presence/absences
qpcr_detection_New_name_no_tech %>% 
  ungroup() %>% 
   group_by(., `Target Name`) %>% 
  dplyr::summarise( NAs =sum(is.na(mean_Quantity)),
    detections = sum(mean_Quantity > 0, na.rm = TRUE),
    non_detections = sum(mean_Quantity == 0, na.rm = TRUE),
    total_samples = n()
  )

# Calculate read statistics for detections > 0
qpcr_detection_New_name_no_tech %>% 
  ungroup() %>% 
   group_by(., `Target Name`) %>% 
  filter(., mean_mean_dnacopy_L >0) %>% 
  dplyr::summarise(mean(mean_mean_dnacopy_L), max(mean_mean_dnacopy_L), sd(mean_mean_dnacopy_L), n_distinct(mean_mean_dnacopy_L))


