# 12S
```{r}
x12S_tax <- read.table(here("rcrux_12S_QiimeClassifier",
                          "12S_efc_derep",
                          "12S_efc_rcrux_blastoutput_uniq-taxa_addAtr.tsv"), 
                         header=T, sep="\t")

x12S_fasta <- readDNAStringSet(here("rcrux_12S_QiimeClassifier",
                      "12S_efc_derep",
                      "12S_efc_rcrux_blastoutput_uniq-seqs_addAtr.fasta"))

names(x12S_fasta) %>% 
  as_tibble() %>% 
  dplyr::rename(Feature.ID=value)-> x12S_accessions

x12S_tax %>% 
  filter(., !str_detect(Taxon,"uncultured")) %>% 
   filter(., !str_detect(Taxon,"environmental samples")) %>% 
   filter(., !str_detect(Taxon,"metagenome")) %>% 
   filter(., !str_detect(Taxon,"unidentified")) %>% 
   filter(., !str_detect(Taxon,"unclassified")) -> x12S_tax_2_keep

x12S_tax %>% 
  filter(., Feature.ID %in% x12S_tax_2_keep$Feature.ID) -> x12S_accessions_2_keep

x12S_tax %>% 
  filter(., !Feature.ID %in% x12S_accessions_2_keep$Feature.ID) -> x12S_accessions_2_toss

x12S_subset_sequences <- x12S_fasta[x12S_accessions_2_keep$Feature.ID]

writeXStringSet(x12S_subset_sequences,file=here("rcrux_12S_QiimeClassifier",
                                                "12S_cleaned_June12_2026",
                                                "12S_cleaned.fasta"))

write_delim(x12S_tax_2_keep,file=here("rcrux_12S_QiimeClassifier",
                                                "12S_cleaned_June12_2026",
                                                "12S_cleaned.tsv"), delim = "\t")

```

