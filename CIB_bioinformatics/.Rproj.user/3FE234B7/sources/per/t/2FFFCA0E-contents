# Comparison

```{r}

data_accessions <- tibble(Marker = c("16Sv4","12S","CO1"),
       Unfiltered_Accessions = c(length(x16Sv4_accessions$Feature.ID),length(x12S_accessions$Feature.ID),length(xCO1_accessions$Feature.ID) ),
       Clean_Accessions = c(length(x16Sv4_accessions_2_keep$Feature.ID),length(x12S_accessions_2_keep$Feature.ID),length(xCO1_accessions_2_keep$Feature.ID) ),
)

data_accessions %>% 
  pivot_longer(., cols=-Marker, values_to = "Accessions", names_to = ("Type")) %>% 
  ggplot(., aes(x= Type, y= Accessions, fill=Marker)) + geom_bar(position = "dodge", stat = "identity") + facet_wrap(.~Marker, scales="free") +theme_pubclean() +theme(legend.position = "null")


ggsave("rcrux_accessions_compare.png")


```

```{r}

data_tax <- tibble(Marker = c("16Sv4","12S","CO1"),
       Unfiltered_tax = c(length(unique(x16Sv4_tax$Taxon)),length(unique(x12S_tax$Taxon)),length(unique(xCO1_tax$Taxon)) ),
       Clean_tax = c(length(unique(x16Sv4_accessions_2_keep$Taxon)),length(unique(x12S_accessions_2_keep$Taxon)),length(unique(xCO1_accessions_2_keep$Taxon)) ))
 
