# ANOVA procedure on rank-transformed data
aov.rnk <- aov(
  rank(meandnaconc_coho) ~ time_chunk * species, data = coho_20m_analysis,
  contrasts = list(
    MATRIX = 'contr.sum',
    LOCATION = 'contr.sum'
  )
)

summary(aov.rnk)


par(mfrow = c(1, 2)) # combine plots

