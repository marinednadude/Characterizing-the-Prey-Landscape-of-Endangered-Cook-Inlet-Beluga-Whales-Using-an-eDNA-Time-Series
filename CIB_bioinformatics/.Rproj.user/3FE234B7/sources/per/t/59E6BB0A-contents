  arrange(ASV) %>% 
  group_by(ASV)  %>% 
  nest() %>% 
  mutate(data = purrr::map(data,  function(.x){
    .x %>%
      ungroup() %>% 
      mutate(idx= match(sum.taxonomy, unique(sum.taxonomy))) %>% 
      separate(sum.taxonomy, into=c("Domain","Phylum","Class","Order","Family","Genus","Species"), sep=";", remove=F) %>% 
      pivot_wider(names_from = idx, values_from = c(sum.taxonomy, Domain,Phylum,Order,Class, Family, Genus, Species),  names_glue = "{.value}:{idx}" ) %>% 
      rowwise %>% 
      mutate(Same_Species = n_distinct(unlist(across(starts_with('Species'), 
                                                     ~ as.character(.x)))) == 1,
             Same_Genus = n_distinct(unlist(across(starts_with('Genus'), 
                                                   ~ as.character(.x)))) == 1,
             Same_Family = n_distinct(unlist(across(starts_with('Family'), 
                                                    ~ as.character(.x)))) == 1,
             Same_Class = n_distinct(unlist(across(starts_with('Class'), 
                                                   ~ as.character(.x)))) == 1,
             Same_Order = n_distinct(unlist(across(starts_with('Order'), 
                                                   ~ as.character(.x)))) == 1,
             Same_Phylum = n_distinct(unlist(across(starts_with('Phylum'), 
                                                    ~ as.character(.x)))) == 1,
             Same_Domain = n_distinct(unlist(across(starts_with('Domain'), 
                                                    ~ as.character(.x)))) == 1) %>%
      ungroup() %>% 
      mutate(., lca_taxonomic_path = case_when(Same_Species==TRUE ~ `sum.taxonomy:1`,
                                               Same_Domain==FALSE ~ paste0(";",";",";",";",";",";"),
                                               Same_Phylum==FALSE ~ paste0(`Domain:1`,";",";",";",";",";",";"),
                                               Same_Order==FALSE ~ paste0(`Domain:1`,";",`Phylum:1`,";",";",";",";",";"),
                                               Same_Class==FALSE ~ paste0(`Domain:1`,";",`Phylum:1`,";",`Order:1`,";",";",";",";"),
                                               Same_Family==FALSE ~ paste0(`Domain:1`,";",`Phylum:1`,";",`Order:1`,";",`Class:1`,";",";",";"),
                                               Same_Genus==FALSE ~ paste0(`Domain:1`,";",`Phylum:1`,";",`Order:1`,";",`Class:1`,";",`Family:1`,";",";"),
