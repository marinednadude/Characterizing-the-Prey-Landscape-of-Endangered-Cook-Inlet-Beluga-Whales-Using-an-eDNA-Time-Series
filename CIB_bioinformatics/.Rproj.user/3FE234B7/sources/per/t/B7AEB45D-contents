### PERMANOVA


```{r,echo=FALSE,warning=FALSE}
#Betadiversity
#Generate Vegan formatted data table
method.sampledf <- data.frame(sample_data(physeq_obj_kenai))
method.rel_abun<- vegan_otu(physeq_obj_kenai)

