# Transform and clean the dataset from the first sequence run
results_reads %>% 
  pivot_longer(cols = `c19_fishcard_Knik_01_R2`:`c19_fishcard_TM_D9_03`, # Convert wide format to long format for specific columns
               names_to = "Sample", 
               values_to = "nReads") %>% 
  mutate(New_name = str_remove(Sample, "c19_fishcard_")) %>% # Remove prefix from sample names
  left_join(metadata) %>% # Join with metadata for additional information
  separate(sum.taxonomy, into = c("Domain", "Phylum", "Class", "Order", "Family", "Genus", "Species"), sep = ";", remove = FALSE) %>% # Split taxonomy info into separate columns
  unite(Site, Location, col = "Station", remove = FALSE) %>% # Combine Site and Location into a new column 'Station'
  ungroup() %>%
  mutate(ID_mifish = if_else(Species == "", Genus, Species)) %>% # Create a unique identifier, prefer Species over Genus
  mutate(ID_mifish = if_else(ID_mifish == "", Family, ID_mifish)) %>% # Use Family if Species and Genus are missing
  mutate(ID_mifish = if_else(ID_mifish == "", Order, ID_mifish)) %>% # Use Order if Family is missing
  mutate(ID_mifish = if_else(ID_mifish == "", Class, ID_mifish)) %>% # Use Class if Order is missing
  mutate(ID_mifish = if_else(ID_mifish == "", Phylum, ID_mifish)) %>% # Use Phylum if Class is missing
  mutate(ID_mifish = if_else(ID_mifish == "", Domain, ID_mifish)) %>% # Use Domain if Phylum is missing
  mutate(ID_mifish = replace_na(ID_mifish, "")) %>% # Replace remaining NA with empty string
  filter(Domain != "") %>% # Filter out rows where Domain is missing
  dplyr::select(-Project, -PCR_Cycles, -Index.Cycles, -Location, -Extraction_set) -> combined_data_long_reads # Select relevant columns and store in combined_data_long_reads

# Convert 'Sample_date' to Date format
combined_data_long_reads$Sample_date <- as.Date(combined_data_long_reads$Sample_date, "%m/%d/%y")

