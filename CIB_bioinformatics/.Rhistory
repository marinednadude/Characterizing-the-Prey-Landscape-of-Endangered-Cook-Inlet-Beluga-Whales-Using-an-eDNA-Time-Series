filter(., River %in% c("Kenai")) %>%
filter(., `Target Name`=="Beluga") %>%
group_by(Sample_date) %>%
dplyr::summarise( avg_Detection_qPCR = mean(mean_dnacopy_L)) %>%
mutate(., avg_Detection_qPCR= if_else(is.na(avg_Detection_qPCR),0,avg_Detection_qPCR)) %>%
mutate(., Detection_qPCR= if_else(avg_Detection_qPCR>0,1,0)) %>%
mutate(time_chunk = case_when(Sample_date < '2021-06-01' ~"Exclude",
Sample_date < "2021-09-01" ~"Before",
TRUE ~"During")) %>%
filter(., time_chunk != "Exclude") %>%
group_by(time_chunk) %>%
mutate(., n_distinct(Sample_date)) %>%
dplyr::summarise(prob_detection=sum(Detection_qPCR)/n_distinct(Sample_date)) %>%
mutate(., Method ="qPCR") -> kenai_summer_fall_qPCR
qPCR_4_species %>%
mutate(., `Target Name`=if_else(`Target Name`=="cetacea","Beluga",`Target Name`)) %>%
filter(., River %in% c("Kenai")) %>%
filter(., `Target Name`=="Beluga") %>%
group_by(Sample_date) %>%
dplyr::summarise( avg_Detection_qPCR = mean(mean_dnacopy_L)) %>%
mutate(., avg_Detection_qPCR= if_else(is.na(avg_Detection_qPCR),0,avg_Detection_qPCR))  %>%
mutate(., Detection_qPCR= if_else(avg_Detection_qPCR>0,1,0)) -> kenai_detect_qPCR
qPCR_4_species %>%
filter(., River=="Twentymile") %>%
mutate(., `Target Name`=case_when(`Target Name`=="cetacea"~ "**Beluga** <br> (*D. leucas*)" ,
`Target Name`=="Eulachon" ~ "**Eulachon** <br> (*T. pacificus*)",
`Target Name`=="Chinook"~ "**Chinook** <br> (*O. tshawytscha*)",
`Target Name`=="Coho" ~ "**Coho** <br> (*O. kisutch*)")) %>%
ggplot(aes(x=Sample_date, y=mean_dnacopy_L+1,color=`Target Name`)) + geom_point()+ facet_wrap(`Target Name`~., scales="free", ncol=1) +
theme(legend.position = "none",axis.text.x = element_text(angle=30, hjust = 1), panel.grid.major = element_blank(), panel.grid.minor = element_blank(), axis.line = element_line(colour = "grey50"),
panel.background = element_blank(), axis.text = element_text(size=18), axis.title = element_text(size=24, face="bold"),  strip.text = element_markdown(size=16))  + scale_color_manual(values = palette_cl) +scale_fill_manual(values = palette_cl) +xlab("Date")+ ylab("qPCR DNA Concentration [copies/L] +1")  +annotate("rect", xmin = as.Date("2021-08-16"), xmax = as.Date("2021-10-21"), ymin = 0, ymax = 200000, alpha = .1,fill ="darkred")    +
scale_y_log10(labels = label_log(), n.breaks=5)
# Pull in qPCR Data
qPCR_AK_data_with_model <- readRDS(file=here("analysis","qPCR_AK_data_with_model.RDS"))
dilution <- 1
# Clean up qPCR data for merging
qPCR_AK_data_with_model %>%
#filter(., `Sample Name`!="" & Sample.Name !="") %>%
filter(., `Target Name` %in% c("cetacea", "Chinook" , "Coho"   ,  "Eulachon")) %>%
filter(., Task =="UNKNOWN") %>%
filter(., !is.na(LabID)) %>%
filter(., !is.na(Volume)) %>%
filter(., !str_detect(New_name_no_tech,"Diet")) %>%
filter(., Sample_Control == "Sample") %>%
mutate(., Sample_date = as.Date(Sample_date,"%m/%d/%y")) %>%
mutate(., Tide_height = as.numeric(Tide_height)) %>%
mutate(., Quantity = as.numeric(str_remove_all(Quantity,","))) %>%
mutate(Quantity = if_else(CT=="Undetermined", 0, Quantity)) %>%
mutate(Quantity = if_else(CT >40, 0, Quantity)) %>%
mutate(Quantity = if_else(is.na(Quantity), 0, Quantity)) %>%
mutate(mean_dnacopy_L = dilution*(100/(Volume/2))*10^mean,
q2.5_dnacopy_L = dilution*(100/(Volume/2))*10^q2.5,
q97.5_dnacopy_L = dilution*(100/(Volume/2))*10^q97.5,
q25_dnacopy_L = dilution*(100/(Volume/2))*10^q25,
q75_dnacopy_L = dilution*(100/(Volume/2))*10^q75,
) %>%
mutate(mean_dnacopy_L = if_else(Quantity==0, 0, mean_dnacopy_L)) -> qPCR_4_species
saveRDS(qPCR_4_species,here("analysis","Output","qPCR_4_species.RDS"))
combined_data_long_reads_c <- readRDS(here("analysis", "Output", "combined_data_long_reads_c.RDS"))
combined_data_long_reads_c$New_name %>%  unique() %>% length()
combined_data_long_reads_c$New_name_no_tech %>%  unique() %>% length()
combined_data_long_reads_c %>%
mutate(total_sum=sum(nReads)) %>%
dplyr::select(total_sum)
combined_data_long_reads_c$Species %>%  unique() %>%  length()-1
combined_data_long_reads_c %>%
filter(., Class=="Mammalia") %>%
dplyr::select(Species) %>% distinct() -> mammals
mammals$Species %>%  length-1
combined_data_long_reads_c %>%
filter(., Class=="Actinopteri") %>%
dplyr::select(Species) %>% distinct() -> fish
fish$Species %>%  length-1
combined_data_long_reads_c %>%
filter(., Class=="Aves") %>%
dplyr::select(Species) %>% distinct() -> birds
birds$Species %>%  length-1
combined_data_long_reads_c %>%
filter(., Class=="Chondrichthyes") %>%
dplyr::select(Species) %>% distinct() -> Chondrichthyes
Chondrichthyes$Species
combined_data_long_reads_c %>%
filter(., Class=="Hyperoartia") %>%
dplyr::select(Species) %>% distinct() -> Hyperoartia
Hyperoartia$Species
combined_data_long_reads_c$Class %>%  unique()
combined_data_long_reads_c %>%
group_by(New_name) %>%
mutate(., total_reads2= sum(nReads)) %>%
filter(., total_reads < 20000)
combined_data_long_reads_c$total_reads %>%  min()
combined_data_long_reads_c$total_reads %>%  max()
combined_data_long_reads_c$total_reads %>%  mean()
combined_data_long_reads_c %>%
filter(., total_reads < 20000) %>%
dplyr::select(New_name) %>%  distinct()
combined_data_long_reads_c %>%
mutate(., salmon = if_else(str_detect(sum.taxonomy,"Oncorhynchus"),"salmon","other")) %>%
filter(., River == "Twentymile") %>%
mutate(., sum.total_reads = sum(nReads)) %>%
group_by(salmon,sum.total_reads) %>%
dplyr::summarise(group_reads = sum(nReads)) %>%
mutate(., perc=group_reads/sum.total_reads)
# Filter for only species observed with qPCR
combined_data_long_reads_c %>%
filter(., Species %in% c("Delphinapterus leucas", "Thaleichthys pacificus","Oncorhynchus tshawytscha","Oncorhynchus kisutch")) -> meta_data_only_qPCR_species_long
meta_data_only_qPCR_species_long %>%
mutate(., Sample_date = as.Date(Sample_date,"%m/%d/%y")) %>%
mutate(., Tide_height = as.numeric(Tide_height)) %>%
left_join(combined_data_long_reads_c) %>%
mutate(., `Target Name`=case_when(Species=="Delphinapterus leucas"~ "cetacea" ,
Species=="Thaleichthys pacificus" ~ "Eulachon",
Species=="Oncorhynchus tshawytscha"~ "Chinook",
Species=="Oncorhynchus kisutch" ~ "Coho")) %>%
left_join(qPCR_4_species) %>%
mutate(., `Target Name`=if_else(`Target Name`=="cetacea","Beluga",`Target Name`))-> combo_4_species
saveRDS(combo_4_species, here("analysis","combo_4_species.RDS"))
